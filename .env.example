# e-chemEd Environment Configuration Template
# Copy this file to .env for local configuration.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- SERVER & PORTS (Local development) ---
PORT=3001
FRONTEND_PORT=3000
NODE_ENV=development

# --- DATABASE PERSISTENCE ---
# Leave unset or empty to use local SQLite (backend/data/echemed.db - zero setup).
# For production (e.g. Vercel), attach Vercel Postgres or Neon to supply POSTGRES_URL.
POSTGRES_URL=
DATABASE_URL=
PG_POOL_MAX=10

# --- FACULTY ADMIN AUTHENTICATION ---
# Required: 32+ character cryptographically secure secret for faculty administration.
# On first local run, start.bat / start.sh generates this automatically.
ADMIN_KEY=change_this_to_a_secure_random_key_min_32_chars

# --- SESSION CODE & PROXY ---
# Optional daily session code for attendance verification (e.g. CHEM101)
SESSION_CODE=

# Set to true when running behind reverse proxies or cloud load balancers (Vercel, Render, Nginx)
TRUST_PROXY=true

# --- CORS SETTINGS ---
# Optional comma-separated origins. Localhost, LAN Wi-Fi IP, and *.vercel.app are allowed automatically.
CORS_ORIGIN=
