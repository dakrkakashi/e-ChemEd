# e-chemEd Backend Environment Configuration

# Server Ports
PORT=3001
FRONTEND_PORT=3000

# Security & Admin Authentication
# Must be set to a cryptographically strong secret.
# In start.bat/start.sh, a 32-byte hex key is automatically generated on first run.
ADMIN_KEY=change_this_to_a_secure_random_key_min_32_chars

# Proxy & Network Settings
# Set to true if running behind Nginx, Caddy, or a reverse proxy
TRUST_PROXY=false

# Optional Attendance Session Code
# If set, students must enter this code when submitting attendance.
# Can also be set/updated dynamically via the faculty Admin Portal.
SESSION_CODE=

# CORS Configuration
# Comma-separated list of additional allowed origins if deployed remotely.
# Localhost, 127.0.0.1, and detected LAN IP on frontend port are allowed by default.
CORS_ORIGIN=
